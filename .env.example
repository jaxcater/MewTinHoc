# ============================================================
# MewTinHoc — biến môi trường phía máy chủ (server/).
# Sao chép file này thành `.env.local` rồi điền giá trị thật.
# `.env.local` đã nằm trong .gitignore (*.local), KHÔNG commit lên git.
# File .env.example này chỉ là mẫu — không đặt secret thật vào đây.
# ============================================================

# --- BẮT BUỘC để chat với CamCam hoạt động ---
# Lấy tại: Botpress Cloud -> chọn bot -> tab "Chat" -> "Chat Configuration"
# Dạng UUID, ví dụ: 5f3c1e2a-9d4b-4a7e-8c21-0b6f7a9de314
#
# ⚠ CẢNH BÁO BẢO MẬT: file này được commit lên git, nên MỌI giá trị điền vào
# đây đều KHÔNG còn là bí mật. Server đọc file này làm phương án dự phòng
# khi bản deploy chưa tạo .env.local, nhưng cách làm đúng là:
#   1. Tạo .env.local trên máy chủ (hoặc thêm GitHub Secrets cho workflow
#      deploy-vps.yml) — .env.local luôn được ưu tiên hơn file mẫu này.
#   2. Nếu bot đã bật Encryption Key: tạo key mới trong Botpress Cloud rồi
#      điền vào .env.local (KHÔNG điền vào file này).
BOTPRESS_WEBHOOK_ID=

# --- TÙY CHỌN: chỉ điền nếu bot có bật "Encryption key" trong Chat settings ---
# Nếu Botpress không bật encryption thì để trống. Không điền vào file này.
BOTPRESS_ENCRYPTION_KEY=

# --- TÙY CHỌN: chỉ dùng cho công cụ quản trị /api/botpress/files ---
# Không cần cho chức năng chat.
BOTPRESS_TOKEN=
BOTPRESS_BOT_ID=

# --- TÙY CHỌN: chỉ đặt khi frontend nằm ở origin khác với backend ---
# Ví dụ: https://mewtinhoc.vn
BOTPRESS_ALLOWED_ORIGIN=

# ============================================================
# GEN ĐỀ THI THỬ (server/exam/)
# ============================================================

# --- Thư mục gốc chứa dữ liệu đề ---
# Mặc định KHÔNG cần đặt: server tự nhận thư mục anh em của repo,
# tức là /www/wwwroot khi repo ở /www/wwwroot/mewtinhoc.
# Chỉ đặt khi muốn để dữ liệu ở chỗ khác.
EXAM_DATA_ROOT=

# --- Khoá mã hoá đáp án trên đĩa (AES-256-GCM) ---
# Khuyến nghị đặt cố định cho production. Nếu để trống, server tự sinh
# file dethicosan/.key-secret (chmod 600).
# ĐỔI KHOÁ = toàn bộ đề trong kho không đọc được → phải exam:reset.
EXAM_KEY_SECRET=

# --- Tùy chọn: bật endpoint /api/exams/health (chỉ admin) ---
# Để trống thì endpoint trả 404 với mọi người (không lộ sự tồn tại).
EXAM_ADMIN_TOKEN=

# --- Supabase: dùng để xác minh người dùng khi họ gọi API gen đề ---
# Lấy ở Supabase -> Project Settings -> API.
# Nếu để trống, server dùng giá trị mặc định trong server/exam/auth.js
# (anon key công khai, an toàn để lộ nhưng nên đặt tường minh).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ============================================================
# ĐÁNH GIÁ CỦA AI — Google AI Studio / Gemini (server/ai/)
# ============================================================

# --- Khoá API Gemini (BẮT BUỘC để nút "Đánh giá của AI" chạy được) ---
# Lấy miễn phí tại: https://aistudio.google.com/apikey  →  "Create API key"
# Khoá có thể ở dạng AIza... (dạng cũ) hoặc AQ.Ab8... (dạng mới của AI Studio).
#
# ⚠ KHOÁ NÀY CHỈ NẰM Ở MÁY CHỦ. Không đặt trong biến VITE_* (Vite sẽ nhúng
# thẳng vào bundle và ai mở web cũng đọc được).
# Trình duyệt gọi POST /api/ai/review; server giữ khoá và gọi Google.
GEMINI_API_KEY=

# --- Tùy chọn: đổi model ---
# Mặc định gemini-3.5-flash. Google hay gặp 503 (quá tải) ở một số model,
# nên server tự thử tiếp gemini-3.6-flash → gemini-3.1-flash-lite →
# gemini-flash-latest trước khi báo lỗi. Không cần khai báo danh sách đó.
#
# Model cũ gemini-2.5-flash đã bị Google khoá với khoá API tạo mới, đừng dùng.
# Chọn model khác nếu tài khoản của bạn chưa mở model mặc định:
#   gemini-3.1-flash-lite  (nhanh/rẻ nhất, câu chữ ngắn hơn)
#   gemini-3.5-flash       (cân bằng, mặc định)
#   gemini-3.1-pro-preview (phân tích sâu hơn, chậm hơn)
GEMINI_MODEL=
