# ============================================================
# MewTinHoc — biến môi trường phía máy chủ (server/).
# Sao chép file này thành `.env.local` rồi điền giá trị thật.
# `.env.local` đã nằm trong .gitignore (*.local), KHÔNG commit lên git.
# File .env.example này chỉ là mẫu — không đặt secret thật vào đây.
# ============================================================

# --- BẮT BUỘC để chat với CamCam hoạt động ---
# Lấy tại: Botpress Cloud -> chọn bot -> tab "Chat" -> "Chat Configuration"
# Dạng UUID, ví dụ: 5f3c1e2a-9d4b-4a7e-8c21-0b6f7a9de314
BOTPRESS_WEBHOOK_ID=495d4013-89a7-4f9c-ad32-1a623750a35c

# --- TÙY CHỌN: chỉ điền nếu bot có bật "Encryption key" trong Chat settings ---
# Nếu Botpress không bật encryption thì để trống.
BOTPRESS_ENCRYPTION_KEY=crackhobomay1cailuonconcho-AnBaoNhi2008

# --- TÙY CHỌN: chỉ dùng cho công cụ quản trị /api/botpress/files ---
# Không cần cho chức năng chat.
BOTPRESS_TOKEN=
BOTPRESS_BOT_ID=

# --- TÙY CHỌN: chỉ đặt khi frontend nằm ở origin khác với backend ---
# Ví dụ: https://mewtinhoc.vn
BOTPRESS_ALLOWED_ORIGIN=

# ============================================================
# GEN ĐỀ THI THỬ (server/exam/)
# ============================================================

# --- Thư mục gốc chứa dữ liệu đề ---
# Mặc định KHÔNG cần đặt: server tự nhận thư mục anh em của repo,
# tức là /www/wwwroot khi repo ở /www/wwwroot/mewtinhoc.
# Chỉ đặt khi muốn để dữ liệu ở chỗ khác.
EXAM_DATA_ROOT=

# --- Khoá mã hoá đáp án trên đĩa (AES-256-GCM) ---
# Khuyến nghị đặt cố định cho production. Nếu để trống, server tự sinh
# file dethicosan/.key-secret (chmod 600).
# ĐỔI KHOÁ = toàn bộ đề trong kho không đọc được → phải exam:reset.
EXAM_KEY_SECRET=

# --- Tùy chọn: bật endpoint /api/exams/health (chỉ admin) ---
# Để trống thì endpoint trả 404 với mọi người (không lộ sự tồn tại).
EXAM_ADMIN_TOKEN=

# --- Supabase: dùng để xác minh người dùng khi họ gọi API gen đề ---
# Lấy ở Supabase -> Project Settings -> API.
# Nếu để trống, server dùng giá trị mặc định trong server/exam/auth.js
# (anon key công khai, an toàn để lộ nhưng nên đặt tường minh).
SUPABASE_URL=
SUPABASE_ANON_KEY=
